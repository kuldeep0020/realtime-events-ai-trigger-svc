# ============================================================
# realtime-ai-trigger-svc — environment variable reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
# ============================================================

# ── Runtime (required for 'serve' mode) ──────────────────────

# StreamNative / Pulsar cluster endpoint
PULSAR_URL=pulsar+ssl://pc-0148c683.aws-use1-prod-3u4fn.aws.snio.cloud:6651

# Pulsar topic that ingestion-svc publishes source events to
PULSAR_TOPIC=persistent://public/enterprise/source-events-rudderstacvilo

# Pulsar shared subscription name (must be stable across restarts)
PULSAR_SUBSCRIPTION=realtime-ai-trigger-svc-v1

# JWT token for Pulsar auth (StreamNative; keep in .env.local / Helm --set)
PULSAR_JWT_TOKEN=<set-me>

# PostgreSQL connection string (in-cluster dev Postgres)
POSTGRES_DSN=postgresql://postuser:postpass@postgres:5432/postdb?sslmode=disable

# Comma-separated RudderStack write keys allowed through the tenant filter
ALLOWED_WRITE_KEYS=<set-me>

# Base URL of the ingestion service (used by demo-fire to POST /v1/batch)
INGESTION_URL=https://rudderstacvilo.dev-rudder.rudderlabs.com

# LLM response mode: 'canned' uses Postgres canned_responses (demo default);
# 'live' calls the local agent / Bedrock (production / seed run only)
LLM_MODE=canned

# Kapa.ai response mode: 'canned' uses Postgres canned_kapa_responses (demo default);
# 'live' calls the real Kapa API (seed run only)
KAPA_MODE=canned

# Activation API mode: 'mock' uses Postgres mock_profiles (demo default);
# 'live' calls the real RudderStack Activation API
ACTIVATION_MODE=mock

# Base URL for the real Activation API (required only when ACTIVATION_MODE=live)
ACTIVATION_BASE_URL=

# Workspace Redis destination ID (required only when ACTIVATION_MODE=live)
ACTIVATION_DEST_ID=

# Service Access Token for Activation API Bearer auth (live mode only)
ACTIVATION_SAT=<set-me>

# Incoming Slack webhook URL for the realestate channel dispatch
SLACK_WEBHOOK_URL=<set-me>

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ── Demo-fire direct-Pulsar mode ─────────────────────────────
# Skip the HTTP gateway and publish events directly to Pulsar. Used by:
#   ./realtime-trigger demo-fire --persona realestate --target pulsar
#
# PULSAR_URL and PULSAR_JWT_TOKEN (above) are reused; only the CA cert
# path is demo-fire-specific when connecting to a self-signed local broker.
# PULSAR_TLS_TRUST_CERT=/Users/kumar/workspace/pulsar-local-ssl/certs/ca.cert.pem

# Controls where POST /api/demo/fire-script publishes events.
# "pulsar" (default) publishes directly to the local Pulsar broker so that
# the in-process consumer receives them end-to-end without going through the
# ingestion-svc HTTP gateway.  Set to "http" only when testing against the
# real ingestion-svc (requires INGESTION_URL to be set).
DEMO_FIRE_TARGET=pulsar

# ── Seed-only (not required at runtime) ──────────────────────

# Local agent API endpoint for seed --from live (SSE streaming)
LOCAL_AGENT_URL=http://localhost:3000/api/agent/stream

# Bearer token for the local agent API
LOCAL_AGENT_TOKEN=<set-me>

# Local agent model tier: Fast | Balanced | Deep
LOCAL_AGENT_MODEL=Fast

# Bedrock presigned API key (12h TTL; fallback when local agent is unavailable)
BEDROCK_API_KEY=<set-me>

# Kapa.ai API key (required only when KAPA_MODE=live i.e. 'seed --from live')
KAPA_API_KEY=<set-me>

# Kapa.ai project ID (required only when KAPA_MODE=live)
KAPA_PROJECT_ID=<set-me>
